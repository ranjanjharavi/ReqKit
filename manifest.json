{
  "manifest_version": 3,
  "name": "ReqKit",
  "version": "1.0",
  "description": "Transform URLs and add domain-bound request headers.",
  "permissions": ["activeTab", "clipboardWrite", "declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReqKit",
    "default_icon": {
      "16": "images/plug.png"
    }
  }
}
