{
  "manifest_version": 3,
  "name": "ReqKit",
  "version": "1.0",
  "minimum_chrome_version": "120",
  "description": "Transform URLs and add domain-bound request headers.",
  "permissions": [
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/reqkit-16.png",
    "32": "icons/reqkit-32.png",
    "48": "icons/reqkit-48.png",
    "128": "icons/reqkit-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ReqKit",
    "default_icon": {
      "16": "icons/reqkit-16.png",
      "32": "icons/reqkit-32.png",
      "48": "icons/reqkit-48.png"
    }
  }
}
