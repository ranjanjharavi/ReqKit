{
  "manifest_version": 3,
  "name": "ReqKit",
  "version": "1.0",
  "minimum_chrome_version": "120",
  "description": "Transform URLs and add domain-bound request headers.",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggle-master": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Pause or resume all ReqKit header rules"
    }
  },
  "icons": {
    "16": "icons/reqkit-16.png",
    "32": "icons/reqkit-32.png",
    "48": "icons/reqkit-48.png",
    "128": "icons/reqkit-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ReqKit",
    "default_icon": {
      "16": "icons/reqkit-16.png",
      "32": "icons/reqkit-32.png",
      "48": "icons/reqkit-48.png"
    }
  }
}
